rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidIncidentId(id) {
      // Firestore document IDs may contain punctuation; only '/' is forbidden.
      return id is string && id.size() >= 1 && id.size() <= 128 && !id.matches('^.*/.*$');
    }

    function isValidDomainId(domain) {
      return domain is string && domain.size() >= 3 && domain.size() <= 120 && domain.matches('^[a-z0-9.\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isEmailVerified() && (
        request.auth.token.email.lower() in [
          'adm.desbloqueio@gmail.com',
          'viniciuscirne@gmail.com',
          'agenciaiconedigital@gmail.com',
          'vinnicirne@gmail.com'
        ] ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        )
      );
    }

    function userEmailDomain() {
      return request.auth.token.email.lower().split('@')[1];
    }

    function isFreeDomain(domain) {
      return isValidDomainId(domain) && (
        exists(/databases/$(database)/documents/free_domains/$(domain))
          ? get(/databases/$(database)/documents/free_domains/$(domain)).data.active == true
          : domain == 'mercadolivre.com'
      );
    }

    function isAutoApproveDomain(domain) {
      return isValidDomainId(domain) && (
        exists(/databases/$(database)/documents/free_domains/$(domain))
          ? (
              get(/databases/$(database)/documents/free_domains/$(domain)).data.active == true &&
              get(/databases/$(database)/documents/free_domains/$(domain)).data.autoApproveReferrals == true
            )
          : domain == 'mercadolivre.com'
      );
    }

    function isAutoApprovedReferral(code) {
      return code is string && code.size() >= 3 && code.size() <= 32 &&
        code.matches('^[a-zA-Z0-9_\\-]+$') &&
        exists(/databases/$(database)/documents/referral_codes/$(code)) &&
        get(/databases/$(database)/documents/referral_codes/$(code)).data.active == true &&
        isAutoApproveDomain(get(/databases/$(database)/documents/referral_codes/$(code)).data.ownerDomain);
    }

    function isPublicWebmailDomain(domain) {
      return domain in [
        'gmail.com', 'googlemail.com', 'hotmail.com', 'outlook.com',
        'live.com', 'yahoo.com', 'yahoo.com.br', 'bol.com.br',
        'uol.com.br', 'icloud.com', 'me.com', 'msn.com'
      ];
    }

    function isCorporateCompanyActive(domain) {
      return isValidDomainId(domain) &&
        !isPublicWebmailDomain(domain) &&
        exists(/databases/$(database)/documents/corporate_companies/$(domain)) &&
        get(/databases/$(database)/documents/corporate_companies/$(domain)).data.active == true;
    }

    function isCorporateLicenseActive(domain) {
      return isCorporateCompanyActive(domain) &&
        get(/databases/$(database)/documents/corporate_companies/$(domain)).data.autoApprove == true;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function profileCompanyDomain(profile) {
      let assigned = profile.get('companyDomain', '');
      return assigned != '' ? assigned : profile.domain;
    }

    function myCompanyDomain() {
      return profileCompanyDomain(myProfile());
    }

    function profileIsCompanyMember(profile, domain) {
      return profileCompanyDomain(profile) == domain &&
        profile.status == 'approved' &&
        profile.get('licenseStatus', 'none') != 'suspended';
    }

    function isCompanyMember(domain) {
      return isEmailVerified() &&
        isValidDomainId(domain) &&
        !isPublicWebmailDomain(domain) &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        profileIsCompanyMember(myProfile(), domain);
    }

    function isDirectCompanyAdmin(domain) {
      return isCompanyMember(domain) && myProfile().get('companyRole', 'member') == 'company_admin';
    }

    function fleetLink(domain) {
      return /databases/$(database)/documents/corporate_fleet_links/$(domain);
    }

    function isDelegatedCompanyAdmin(domain) {
      let link = get(fleetLink(domain)).data;
      return link.status == 'approved' && link.scope == 'full' &&
        isCorporateCompanyActive(link.parentDomain) && isDirectCompanyAdmin(link.parentDomain);
    }

    function isCompanyAdmin(domain) {
      return isDirectCompanyAdmin(domain) || (isEmailVerified() &&
        isCorporateCompanyActive(domain) && exists(fleetLink(domain)) && isDelegatedCompanyAdmin(domain));
    }

    function myEmailLicenseId() {
      return 'lic_' + request.auth.token.email.lower().replace('[^a-z0-9]+', '_');
    }

    function assignedLicense(domain) {
      return get(/databases/$(database)/documents/corporate_companies/$(domain)/licenses/$(myEmailLicenseId())).data;
    }

    function assignedLicenseMatches(domain, license) {
      return license.status == 'active' &&
        license.email.lower() == request.auth.token.email.lower() &&
        license.companyDomain == domain;
    }

    function hasActiveAssignedLicense(domain) {
      return isCorporateCompanyActive(domain) &&
        request.auth.token.email.size() <= 120 &&
        exists(/databases/$(database)/documents/corporate_companies/$(domain)/licenses/$(myEmailLicenseId())) &&
        assignedLicenseMatches(domain, assignedLicense(domain));
    }

    function assignedLicenseCanEdit(domain) {
      let license = assignedLicense(domain);
      return assignedLicenseMatches(domain, license) &&
        (license.get('incidentAccess', 'read') == 'edit' || license.companyRole == 'company_admin');
    }

    function profileCanEditIncidents(profile, domain) {
      return profile.get('companyRole', 'member') == 'company_admin' ||
        profile.get('incidentAccess', 'read') == 'edit' ||
        (
          request.auth.token.email.size() <= 120 &&
          exists(/databases/$(database)/documents/corporate_companies/$(domain)/licenses/$(myEmailLicenseId())) &&
          assignedLicenseCanEdit(domain)
        );
    }

    function canEditCompanyIncidents(domain) {
      return isAdmin() || (
        isCorporateCompanyActive(domain) &&
        isCompanyMember(domain) &&
        profileCanEditIncidents(myProfile(), domain)
      ) || (isEmailVerified() && isCorporateCompanyActive(domain) &&
        exists(fleetLink(domain)) && isDelegatedCompanyAdmin(domain));
    }

    function canReadCompanyIncidents(domain) {
      return isAdmin() || (isCorporateCompanyActive(domain) && (isCompanyMember(domain) || isCompanyAdmin(domain)));
    }

    // 3. Entity Validation Blueprints
    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'uid', 'email', 'domain', 'displayName', 'photoURL',
          'role', 'status', 'planId', 'referralCode',
          'referredByCode', 'referredByUid', 'referredByDomain',
          'autoApprovedBy', 'accessCount', 'notes',
          'createdAt', 'updatedAt', 'lastLoginAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'email', 'domain', 'displayName', 'photoURL',
          'role', 'status', 'planId', 'referralCode',
          'referredByCode', 'referredByUid', 'referredByDomain',
          'autoApprovedBy', 'licenseKey', 'companyDomain', 'licenseStatus', 'companyRole',
          'incidentAccess',
          'accessCount', 'notes',
          'createdAt', 'updatedAt', 'lastLoginAt'
        ]) &&
        isValidId(data.uid) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        isValidDomainId(data.domain) &&
        data.displayName is string && data.displayName.size() <= 120 &&
        data.photoURL is string && data.photoURL.size() <= 500 &&
        data.role in ['user', 'admin'] &&
        data.status in ['approved', 'pending', 'blocked'] &&
        isValidId(data.planId) && data.planId.size() <= 64 &&
        isValidId(data.referralCode) && data.referralCode.size() <= 32 &&
        data.referredByCode is string && data.referredByCode.size() <= 32 &&
        data.referredByUid is string && data.referredByUid.size() <= 128 &&
        data.referredByDomain is string && data.referredByDomain.size() <= 120 &&
        data.autoApprovedBy in ['admin_bootstrap', 'free_domain', 'meli_referral', 'manual_admin', 'pending_approval', 'corporate_license'] &&
        (!('licenseKey' in data) || (data.licenseKey is string && data.licenseKey.size() <= 64)) &&
        (!('companyDomain' in data) || (data.companyDomain is string && data.companyDomain.size() <= 120)) &&
        (!('licenseStatus' in data) || data.licenseStatus in ['active', 'none', 'suspended']) &&
        (!('companyRole' in data) || data.companyRole in ['member', 'company_admin']) &&
        (!('incidentAccess' in data) || data.incidentAccess in ['read', 'edit']) &&
        data.accessCount is number && data.accessCount >= 0 &&
        data.notes is string && data.notes.size() <= 500 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        data.lastLoginAt is timestamp;
    }

    function isValidReferralCode(data) {
      return data.keys().hasAll([
          'code', 'ownerUid', 'ownerName', 'ownerDomain',
          'active', 'totalReferrals', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'code', 'ownerUid', 'ownerName', 'ownerDomain',
          'active', 'totalReferrals', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.code) && data.code.size() <= 32 &&
        isValidId(data.ownerUid) &&
        data.ownerName is string && data.ownerName.size() <= 120 &&
        isValidDomainId(data.ownerDomain) &&
        data.active is bool &&
        data.totalReferrals is number && data.totalReferrals >= 0 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidReferralRecord(data) {
      return data.keys().hasAll([
          'id', 'code', 'referrerUid', 'referrerName', 'referrerDomain',
          'referredUid', 'referredName', 'referredEmail', 'referredDomain',
          'status', 'autoApproved', 'commissionEnabled', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'code', 'referrerUid', 'referrerName', 'referrerDomain',
          'referredUid', 'referredName', 'referredEmail', 'referredDomain',
          'status', 'autoApproved', 'commissionEnabled', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.code) && data.code.size() <= 32 &&
        isValidId(data.referrerUid) &&
        data.referrerName is string && data.referrerName.size() <= 120 &&
        data.referrerDomain is string && data.referrerDomain.size() <= 120 &&
        isValidId(data.referredUid) &&
        data.referredName is string && data.referredName.size() <= 120 &&
        data.referredEmail is string && data.referredEmail.size() >= 3 && data.referredEmail.size() <= 160 &&
        isValidDomainId(data.referredDomain) &&
        data.status in ['approved', 'pending', 'revoked'] &&
        data.autoApproved is bool &&
        data.commissionEnabled is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidFreeDomain(data) {
      return data.keys().hasAll([
          'domain', 'label', 'active', 'autoApproveReferrals', 'defaultPlanId',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'domain', 'label', 'active', 'autoApproveReferrals', 'defaultPlanId',
          'createdAt', 'updatedAt'
        ]) &&
        isValidDomainId(data.domain) &&
        data.label is string && data.label.size() >= 1 && data.label.size() <= 100 &&
        data.active is bool &&
        data.autoApproveReferrals is bool &&
        isValidId(data.defaultPlanId) && data.defaultPlanId.size() <= 64 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCorporateCompany(data) {
      return data.keys().hasAll([
          'domain', 'companyName', 'planId', 'pricePerLicense',
          'licensedSeats', 'autoApprove', 'active', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'domain', 'companyName', 'planId', 'pricePerLicense',
          'licensedSeats', 'autoApprove', 'active', 'createdAt', 'updatedAt'
        ]) &&
        isValidDomainId(data.domain) &&
        data.companyName is string && data.companyName.size() >= 1 && data.companyName.size() <= 120 &&
        isValidId(data.planId) && data.planId.size() <= 64 &&
        data.pricePerLicense is number && data.pricePerLicense >= 0 &&
        data.licensedSeats is number && data.licensedSeats >= 0 &&
        data.autoApprove is bool &&
        data.active is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCorporateUserLicense(data) {
      return data.keys().hasAll([
          'id', 'email', 'displayName', 'companyDomain', 'planId',
          'licenseKey', 'status', 'companyRole', 'assignedUid', 'invitedByUid',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'email', 'displayName', 'companyDomain', 'planId',
          'licenseKey', 'status', 'companyRole', 'assignedUid', 'invitedByUid',
          'incidentAccess',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 120 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
        isValidDomainId(data.companyDomain) &&
        isValidId(data.planId) && data.planId.size() <= 64 &&
        data.licenseKey is string && data.licenseKey.size() >= 4 && data.licenseKey.size() <= 64 &&
        data.status in ['active', 'suspended'] &&
        data.companyRole in ['member', 'company_admin'] &&
        (!('incidentAccess' in data) || data.incidentAccess in ['read', 'edit']) &&
        data.assignedUid is string && data.assignedUid.size() <= 128 &&
        isValidId(data.invitedByUid) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCorporatePackageIncident(data) {
      let quantity = data.get('packageQuantity', 100000);
      let delivered = data.get('packagesDelivered', 0);
      let recovered = data.get('packagesRecovered', 0);
      let stolen = data.get('packagesStolen', 0);
      let unitValue = data.get('estimatedUnitValue', 0);
      let latitude = data.get('lat', 0);
      let longitude = data.get('lng', 0);
      let history = data.get('history', []);
      return data.keys().hasOnly([
          'id', 'companyDomain', 'trackingCode', 'incidentType', 'boNumber',
          'delegaciaId', 'delegaciaName', 'delegaciaUf', 'delegaciaMunicipio',
          'packageAtStation', 'custodyStatus', 'estimatedValue', 'notes',
          'lat', 'lng', 'address', 'bairro', 'history', 'legacyCreatedAt',
          'carrierName', 'packageQuantity', 'estimatedUnitValue',
          'packagesDelivered', 'packagesRecovered', 'packagesStolen',
          'createdByUid', 'createdByName', 'createdAt', 'updatedAt'
        ]) &&
        data.trackingCode is string && data.trackingCode.size() >= 1 && data.trackingCode.size() <= 80 &&
        data.incidentType in ['extravio', 'fraude', 'roubo_carga', 'roubo', 'furto', 'apreensao', 'ameaca', 'outros'] &&
        data.boNumber is string && data.boNumber.size() <= 64 &&
        data.delegaciaId is string && data.delegaciaId.size() >= 1 && data.delegaciaId.size() <= 64 &&
        data.delegaciaName is string && data.delegaciaName.size() >= 1 && data.delegaciaName.size() <= 160 &&
        data.delegaciaUf is string && data.delegaciaUf.size() >= 1 && data.delegaciaUf.size() <= 8 &&
        data.delegaciaMunicipio is string && data.delegaciaMunicipio.size() <= 100 &&
        data.packageAtStation is bool &&
        data.custodyStatus in [
          'em_ocorrencia_delegacia',
          'aguardando_pericia',
          'liberado_retirada',
          'devolvido_empresa',
          'extraviado_nao_localizado'
        ] &&
        data.estimatedValue is number && data.estimatedValue >= 0 && data.estimatedValue <= 100000000000000 &&
        data.notes is string && data.notes.size() <= 1000 &&
        (!('carrierName' in data) || (data.carrierName is string && data.carrierName.size() <= 120)) &&
        quantity is int && quantity >= 1 && quantity <= 100000 &&
        unitValue is number && unitValue >= 0 && unitValue <= 1000000000 &&
        delivered is int && delivered >= 0 && delivered <= quantity &&
        recovered is int && recovered >= 0 && recovered <= quantity &&
        stolen is int && stolen >= 0 && stolen <= quantity &&
        latitude is number && latitude >= -90 && latitude <= 90 &&
        longitude is number && longitude >= -180 && longitude <= 180 &&
        (!('address' in data) || (data.address is string && data.address.size() <= 250)) &&
        (!('bairro' in data) || (data.bairro is string && data.bairro.size() <= 120)) &&
        (!('legacyCreatedAt' in data) || (data.legacyCreatedAt is string && data.legacyCreatedAt.size() <= 64)) &&
        history is list && history.size() <= 100 && (history.size() == 0 || history[0] is map) &&
        isValidId(data.createdByUid) &&
        data.createdByName is string && data.createdByName.size() <= 120 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function preservesIncidentMetadata(before, after) {
      let changes = after.diff(before);
      return !changes.affectedKeys().hasAny(['createdByUid', 'createdByName', 'createdAt', 'legacyCreatedAt']) &&
        changes.removedKeys().hasOnly([
          'lat', 'lng', 'address', 'bairro', 'history', 'carrierName', 'packageQuantity', 'estimatedUnitValue',
          'packagesDelivered', 'packagesRecovered', 'packagesStolen'
        ]);
    }

    function isValidIncidentAuditLog(data) {
      return data.keys().hasOnly([
          'id', 'companyDomain', 'incidentId', 'trackingCode', 'boNumber',
          'delegaciaName', 'action', 'previousStatus', 'newStatus',
          'previousAtStation', 'newAtStation', 'actorUid', 'actorName',
          'actorEmail', 'summary', 'createdAt'
        ]) &&
        isValidId(data.id) &&
        isValidDomainId(data.companyDomain) &&
        isValidIncidentId(data.incidentId) &&
        data.trackingCode is string && data.trackingCode.size() >= 1 && data.trackingCode.size() <= 80 &&
        data.boNumber is string && data.boNumber.size() <= 64 &&
        data.delegaciaName is string && data.delegaciaName.size() <= 160 &&
        data.action in ['created', 'status_changed', 'station_toggled', 'history_added', 'updated', 'deleted'] &&
        data.previousStatus is string && data.previousStatus.size() <= 64 &&
        data.newStatus is string && data.newStatus.size() <= 64 &&
        data.previousAtStation is bool &&
        data.newAtStation is bool &&
        isValidId(data.actorUid) &&
        data.actorName is string && data.actorName.size() <= 120 &&
        data.actorEmail is string && data.actorEmail.size() >= 3 && data.actorEmail.size() <= 160 &&
        data.summary is string && data.summary.size() <= 500 &&
        data.createdAt is timestamp;
    }

    function isValidPlanConfig(data) {
      return data.keys().hasAll([
          'id', 'name', 'description', 'priceMonthly', 'maxQueriesPerMonth',
          'features', 'active', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'name', 'description', 'priceMonthly', 'billingModel', 'pricePerLicense',
          'maxQueriesPerMonth', 'features', 'active', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) && data.id.size() <= 64 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
        data.description is string && data.description.size() <= 300 &&
        data.priceMonthly is number && data.priceMonthly >= 0 &&
        (!('billingModel' in data) || data.billingModel in ['fixed', 'per_user']) &&
        (!('pricePerLicense' in data) || (data.pricePerLicense is number && data.pricePerLicense >= 0)) &&
        data.maxQueriesPerMonth is number && data.maxQueriesPerMonth >= 0 &&
        data.features is list && data.features.size() <= 10 &&
        (data.features.size() == 0 || (data.features[0] is string && data.features[0].size() <= 100)) &&
        data.active is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAccessLog(data) {
      return data.keys().hasAll([
          'id', 'uid', 'userName', 'userEmail', 'userDomain',
          'targetType', 'targetName', 'uf', 'municipio', 'cisp', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'uid', 'userName', 'userEmail', 'userDomain',
          'targetType', 'targetName', 'uf', 'municipio', 'cisp', 'createdAt'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.uid) &&
        data.userName is string && data.userName.size() <= 120 &&
        data.userEmail is string && data.userEmail.size() >= 3 && data.userEmail.size() <= 160 &&
        isValidDomainId(data.userDomain) &&
        data.targetType is string && data.targetType.size() >= 1 && data.targetType.size() <= 40 &&
        data.targetName is string && data.targetName.size() >= 1 && data.targetName.size() <= 160 &&
        data.uf is string && data.uf.size() <= 16 &&
        data.municipio is string && data.municipio.size() <= 100 &&
        data.cisp is number && data.cisp >= 0 &&
        data.createdAt is timestamp;
    }

    function isValidAdminRegistry(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'createdAt']) &&
        isValidId(data.uid) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        data.createdAt is timestamp;
    }

    // 4. Collection Rules

    // /users/{userId}
    match /users/{userId} {
      allow get: if isValidId(userId) && (
        isOwner(userId) || isAdmin() ||
        isCompanyAdmin(resource.data.get('companyDomain', '') != ''
          ? resource.data.companyDomain
          : resource.data.domain)
      );
      allow list: if isAdmin() || (
        isEmailVerified() &&
        isCompanyAdmin(resource.data.companyDomain)
      );

      allow create: if isValidId(userId) &&
        isOwner(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == request.auth.uid &&
        incoming().email.lower() == request.auth.token.email.lower() &&
        incoming().domain == userEmailDomain() &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        incoming().lastLoginAt == request.time &&
        incoming().accessCount == 0 &&
        (
          isAdmin() || (
            incoming().role == 'user' &&
            (
              incoming().get('companyDomain', '') == '' ||
              (incoming().companyDomain == incoming().domain && incoming().autoApprovedBy == 'corporate_license')
            ) &&
            (
              (
                incoming().status == 'approved' && (
                  (
                    isEmailVerified() &&
                    isFreeDomain(incoming().domain) &&
                    incoming().autoApprovedBy == 'free_domain' &&
                    incoming().get('companyRole', 'member') == 'member' &&
                    incoming().get('incidentAccess', 'read') == 'read'
                  ) ||
                  (
                    isEmailVerified() &&
                    hasActiveAssignedLicense(incoming().domain) &&
                    incoming().autoApprovedBy == 'corporate_license' &&
                    incoming().get('companyDomain', '') == incoming().domain &&
                    incoming().get('licenseStatus', 'none') == 'active' &&
                    incoming().get('licenseKey', '') == get(/databases/$(database)/documents/corporate_companies/$(incoming().domain)/licenses/$(myEmailLicenseId())).data.licenseKey &&
                    incoming().get('companyRole', 'member') == get(/databases/$(database)/documents/corporate_companies/$(incoming().domain)/licenses/$(myEmailLicenseId())).data.companyRole &&
                    incoming().get('incidentAccess', 'read') == get(/databases/$(database)/documents/corporate_companies/$(incoming().domain)/licenses/$(myEmailLicenseId())).data.get('incidentAccess', 'read') &&
                    incoming().planId == get(/databases/$(database)/documents/corporate_companies/$(incoming().domain)/licenses/$(myEmailLicenseId())).data.planId
                  ) ||
                  (
                    isEmailVerified() &&
                    isCorporateLicenseActive(incoming().domain) &&
                    incoming().autoApprovedBy == 'corporate_license' &&
                    incoming().get('companyDomain', '') == incoming().domain &&
                    incoming().get('licenseStatus', 'none') == 'active' &&
                    incoming().get('licenseKey', '').size() >= 4 &&
                    incoming().get('companyRole', 'member') == 'member' &&
                    incoming().get('incidentAccess', 'read') == 'read' &&
                    incoming().planId == get(/databases/$(database)/documents/corporate_companies/$(incoming().domain)).data.planId
                  ) ||
                  (
                    isAutoApprovedReferral(incoming().referredByCode) &&
                    incoming().autoApprovedBy == 'meli_referral' &&
                    incoming().get('companyRole', 'member') == 'member' &&
                    incoming().get('incidentAccess', 'read') == 'read'
                  )
                )
              ) ||
              (
                incoming().status == 'pending' &&
                incoming().autoApprovedBy == 'pending_approval' &&
                incoming().get('licenseStatus', 'none') == 'none' &&
                incoming().get('companyRole', 'member') == 'member'
              )
            )
          )
        );

      allow update: if isValidId(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().email == existing().email &&
        incoming().domain == existing().domain &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (
            isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'planId', 'role', 'notes', 'autoApprovedBy',
              'licenseKey', 'companyDomain', 'licenseStatus', 'companyRole',
              'incidentAccess',
              'displayName', 'photoURL', 'lastLoginAt', 'accessCount', 'updatedAt'
            ])
          ) ||
          (
            isCompanyAdmin(existing().domain) &&
            isCorporateCompanyActive(existing().domain) &&
            existing().role == 'user' &&
            incoming().role == 'user' &&
            userId != request.auth.uid &&
            existing().get('companyDomain', '') in ['', existing().domain] &&
            (
              incoming().get('companyDomain', '') == existing().domain ||
              (
                incoming().get('companyDomain', '') == '' &&
                incoming().get('licenseStatus', 'none') == 'suspended' &&
                incoming().get('companyRole', 'member') == 'member' &&
                incoming().get('incidentAccess', 'read') == 'read'
              )
            ) &&
            incoming().planId in [existing().planId, get(/databases/$(database)/documents/corporate_companies/$(existing().domain)).data.planId] &&
            incoming().referralCode == existing().referralCode &&
            incoming().referredByCode == existing().referredByCode &&
            incoming().referredByUid == existing().referredByUid &&
            incoming().referredByDomain == existing().referredByDomain &&
            incoming().notes == existing().notes &&
            incoming().accessCount == existing().accessCount &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'planId', 'autoApprovedBy', 'licenseKey', 'companyDomain',
              'licenseStatus', 'companyRole', 'incidentAccess', 'updatedAt'
            ])
          ) ||
          (
            isOwner(userId) &&
            (
              // Safe login/access refresh for older profiles without optional fields.
              (
                incoming().diff(existing()).affectedKeys().hasOnly([
                  'displayName', 'photoURL', 'lastLoginAt', 'updatedAt', 'accessCount'
                ]) &&
                (
                  ('accessCount' in existing() &&
                    incoming().accessCount >= existing().accessCount &&
                    incoming().accessCount <= existing().accessCount + 1) ||
                  (!('accessCount' in existing()) && incoming().accessCount <= 1)
                )
              ) ||
              (
                incoming().role == existing().role &&
                incoming().status == existing().status &&
                incoming().planId == existing().planId &&
                incoming().referralCode == existing().referralCode &&
                incoming().referredByCode == existing().referredByCode &&
                incoming().referredByUid == existing().referredByUid &&
                incoming().referredByDomain == existing().referredByDomain &&
                incoming().autoApprovedBy == existing().autoApprovedBy &&
                incoming().get('licenseKey', '') == existing().get('licenseKey', '') &&
                incoming().get('companyDomain', '') == existing().get('companyDomain', '') &&
                incoming().get('licenseStatus', 'none') == existing().get('licenseStatus', 'none') &&
                incoming().get('companyRole', 'member') == existing().get('companyRole', 'member') &&
                incoming().get('incidentAccess', 'read') == existing().get('incidentAccess', 'read') &&
                incoming().notes == existing().notes &&
                incoming().accessCount >= existing().accessCount &&
                incoming().accessCount <= existing().accessCount + 1 &&
                incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'lastLoginAt', 'updatedAt', 'accessCount'])
              ) ||
              (
                isEmailVerified() &&
                existing().status in ['pending', 'approved'] &&
                incoming().status == 'approved' &&
                incoming().role == existing().role &&
                incoming().referralCode == existing().referralCode &&
                incoming().referredByCode == existing().referredByCode &&
                incoming().referredByUid == existing().referredByUid &&
                incoming().referredByDomain == existing().referredByDomain &&
                incoming().notes == existing().notes &&
                incoming().accessCount == existing().accessCount &&
                (
                  (
                    existing().status == 'pending' &&
                    isFreeDomain(existing().domain) &&
                    incoming().planId == existing().planId &&
                    incoming().autoApprovedBy == 'free_domain' &&
                    incoming().get('licenseKey', '') == existing().get('licenseKey', '') &&
                    incoming().get('companyDomain', '') == existing().get('companyDomain', '') &&
                    incoming().get('licenseStatus', 'none') == existing().get('licenseStatus', 'none') &&
                    incoming().get('companyRole', 'member') == existing().get('companyRole', 'member') &&
                    incoming().get('incidentAccess', 'read') == existing().get('incidentAccess', 'read') &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['status', 'autoApprovedBy', 'displayName', 'photoURL', 'lastLoginAt', 'updatedAt'])
                  ) ||
                  (
                    hasActiveAssignedLicense(existing().domain) &&
                    incoming().autoApprovedBy == 'corporate_license' &&
                    incoming().planId == get(/databases/$(database)/documents/corporate_companies/$(existing().domain)/licenses/$(myEmailLicenseId())).data.planId &&
                    incoming().get('companyDomain', '') == existing().domain &&
                    incoming().get('licenseStatus', 'none') == 'active' &&
                    incoming().get('licenseKey', '') == get(/databases/$(database)/documents/corporate_companies/$(existing().domain)/licenses/$(myEmailLicenseId())).data.licenseKey &&
                    incoming().get('companyRole', 'member') == get(/databases/$(database)/documents/corporate_companies/$(existing().domain)/licenses/$(myEmailLicenseId())).data.companyRole &&
                    incoming().get('incidentAccess', 'read') == get(/databases/$(database)/documents/corporate_companies/$(existing().domain)/licenses/$(myEmailLicenseId())).data.get('incidentAccess', 'read') &&
                    incoming().diff(existing()).affectedKeys().hasOnly([
                      'status', 'autoApprovedBy', 'planId', 'licenseKey', 'companyDomain', 'licenseStatus', 'companyRole', 'incidentAccess',
                      'displayName', 'photoURL', 'lastLoginAt', 'updatedAt'
                    ])
                  ) ||
                  (
                    (existing().status == 'pending' || existing().get('licenseStatus', 'none') == 'none') &&
                    isCorporateLicenseActive(existing().domain) &&
                    incoming().autoApprovedBy == 'corporate_license' &&
                    incoming().planId == get(/databases/$(database)/documents/corporate_companies/$(existing().domain)).data.planId &&
                    incoming().get('companyDomain', '') == existing().domain &&
                    incoming().get('licenseStatus', 'none') == 'active' &&
                    incoming().get('licenseKey', '').size() >= 4 &&
                    incoming().get('companyRole', 'member') == existing().get('companyRole', 'member') &&
                    incoming().get('incidentAccess', 'read') == existing().get('incidentAccess', 'read') &&
                    incoming().diff(existing()).affectedKeys().hasOnly([
                      'status', 'autoApprovedBy', 'planId', 'licenseKey', 'companyDomain', 'licenseStatus',
                      'displayName', 'photoURL', 'lastLoginAt', 'updatedAt'
                    ])
                  )
                )
              )
            )
          )
        );

      allow delete: if isValidId(userId) && isAdmin();
    }

    // /referral_codes/{code}
    match /referral_codes/{code} {
      allow get: if isValidId(code) && isSignedIn();
      allow list: if isAdmin() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);

      allow create: if isValidId(code) &&
        isEmailVerified() &&
        isValidReferralCode(incoming()) &&
        incoming().code == code &&
        incoming().ownerUid == request.auth.uid &&
        incoming().ownerDomain == userEmailDomain() &&
        incoming().totalReferrals == 0 &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidId(code) &&
        isValidReferralCode(incoming()) &&
        incoming().code == existing().code &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().ownerDomain == existing().ownerDomain &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (
            isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['active', 'ownerName', 'totalReferrals', 'updatedAt'])
          ) ||
          (
            isSignedIn() &&
            request.auth.uid != existing().ownerUid &&
            incoming().active == existing().active &&
            incoming().ownerName == existing().ownerName &&
            incoming().totalReferrals == existing().totalReferrals + 1 &&
            exists(/databases/$(database)/documents/referrals/$(existing().ownerUid + '_' + request.auth.uid)) &&
            get(/databases/$(database)/documents/referrals/$(existing().ownerUid + '_' + request.auth.uid)).data.code == code &&
            incoming().diff(existing()).affectedKeys().hasOnly(['totalReferrals', 'updatedAt'])
          )
        );

      allow delete: if isValidId(code) && isAdmin();
    }

    // /referrals/{referralId}
    match /referrals/{referralId} {
      allow get: if isValidId(referralId) && (
        isAdmin() ||
        (isSignedIn() && (resource.data.referrerUid == request.auth.uid || resource.data.referredUid == request.auth.uid))
      );
      allow list: if isAdmin() || (isSignedIn() && resource.data.referrerUid == request.auth.uid);

      allow create: if isValidId(referralId) &&
        isSignedIn() &&
        isValidReferralRecord(incoming()) &&
        incoming().id == referralId &&
        incoming().referredUid == request.auth.uid &&
        incoming().referredEmail.lower() == request.auth.token.email.lower() &&
        incoming().referredDomain == userEmailDomain() &&
        incoming().commissionEnabled == false &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/referral_codes/$(incoming().code)) &&
        incoming().referrerUid == get(/databases/$(database)/documents/referral_codes/$(incoming().code)).data.ownerUid &&
        incoming().referrerDomain == get(/databases/$(database)/documents/referral_codes/$(incoming().code)).data.ownerDomain &&
        (
          (incoming().status == 'approved' && incoming().autoApproved == true && isAutoApprovedReferral(incoming().code)) ||
          (incoming().status == 'pending' && incoming().autoApproved == false)
        );

      allow update: if isValidId(referralId) &&
        isAdmin() &&
        isValidReferralRecord(incoming()) &&
        incoming().id == existing().id &&
        incoming().code == existing().code &&
        incoming().referrerUid == existing().referrerUid &&
        incoming().referredUid == existing().referredUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'commissionEnabled', 'updatedAt']);

      allow delete: if isValidId(referralId) && isAdmin();
    }

    // /free_domains/{domainId}
    match /free_domains/{domainId} {
      allow get: if isValidDomainId(domainId) && isSignedIn();
      allow list: if isAdmin();

      allow create: if isValidDomainId(domainId) &&
        isAdmin() &&
        isValidFreeDomain(incoming()) &&
        incoming().domain == domainId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidDomainId(domainId) &&
        isAdmin() &&
        isValidFreeDomain(incoming()) &&
        incoming().domain == existing().domain &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['label', 'active', 'autoApproveReferrals', 'defaultPlanId', 'updatedAt']);

      allow delete: if isValidDomainId(domainId) && isAdmin();
    }

    // A company establishes itself as the principal before sending requests.
    // Principals cannot be approved as carriers, keeping this tree two company levels deep.
    match /corporate_fleet_roots/{domain} {
      allow get: if isAdmin() || isDirectCompanyAdmin(domain);
      allow list, update, delete: if false;
      allow create: if isValidDomainId(domain) && isCorporateCompanyActive(domain) &&
        (isAdmin() || isDirectCompanyAdmin(domain)) &&
        (!exists(fleetLink(domain)) || get(fleetLink(domain)).data.status != 'approved') &&
        incoming().keys().hasOnly(['createdAt']) && incoming().createdAt == request.time;
    }

    match /corporate_fleet_links/{child} {
      function manages(domain) {
        return isAdmin() || isDirectCompanyAdmin(domain);
      }

      function canRequest(parent) {
        return isValidDomainId(parent) && isValidDomainId(child) && parent != child &&
          manages(parent) && isCorporateCompanyActive(parent) && isCorporateCompanyActive(child) &&
          existsAfter(/databases/$(database)/documents/corporate_fleet_roots/$(parent)) &&
          !existsAfter(/databases/$(database)/documents/corporate_fleet_roots/$(child));
      }

      allow get: if isValidDomainId(child) && (manages(child) ||
        (manages(existing().parentDomain) && isCorporateCompanyActive(existing().parentDomain) && isCorporateCompanyActive(child)));
      allow list: if isAdmin() || (isEmailVerified() && isDirectCompanyAdmin(myCompanyDomain()) &&
        resource.data.parentDomain == myCompanyDomain());

      allow create: if canRequest(incoming().parentDomain) &&
        incoming().keys().hasOnly(['parentDomain', 'status', 'createdAt', 'updatedAt']) &&
        incoming().status == 'pending' && incoming().createdAt == request.time && incoming().updatedAt == request.time;

      allow update: if manages(child) && isCorporateCompanyActive(child) &&
        isCorporateCompanyActive(existing().parentDomain) &&
        !existsAfter(/databases/$(database)/documents/corporate_fleet_roots/$(child)) &&
        existing().status in ['pending', 'approved'] &&
        incoming().status == 'approved' && incoming().scope in ['drivers', 'full'] &&
        incoming().childName == get(/databases/$(database)/documents/corporate_companies/$(child)).data.companyName &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'scope', 'childName', 'updatedAt']) &&
        incoming().updatedAt == request.time;

      allow delete: if manages(child) || manages(existing().parentDomain);
    }

    // /corporate_companies/{domainId}
    match /corporate_companies/{domainId} {
      allow get: if isValidDomainId(domainId) && (
        isAdmin() ||
        (isSignedIn() && userEmailDomain() == domainId) ||
        isCompanyMember(domainId) || isCompanyAdmin(domainId)
      );
      allow list: if isAdmin();

      allow create: if isValidDomainId(domainId) &&
        !isPublicWebmailDomain(domainId) &&
        isAdmin() &&
        isValidCorporateCompany(incoming()) &&
        incoming().domain == domainId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidDomainId(domainId) &&
        isValidCorporateCompany(incoming()) &&
        incoming().domain == existing().domain &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isAdmin() &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'companyName', 'planId', 'pricePerLicense', 'licensedSeats',
          'autoApprove', 'active', 'updatedAt'
        ]);

      allow delete: if isValidDomainId(domainId) && isAdmin();

      // /corporate_companies/{domainId}/licenses/{licenseId}
      match /licenses/{licenseId} {
        allow get: if isValidDomainId(domainId) && isValidId(licenseId) && (
          isAdmin() ||
          (isCorporateCompanyActive(domainId) && isCompanyAdmin(domainId)) ||
          (isEmailVerified() && isCorporateCompanyActive(domainId) && licenseId == myEmailLicenseId())
        );
        allow list: if isValidDomainId(domainId) && (
          isAdmin() ||
          (isCorporateCompanyActive(domainId) && isCompanyAdmin(domainId))
        );

        allow create: if isValidDomainId(domainId) && isValidId(licenseId) &&
          isValidCorporateUserLicense(incoming()) &&
          (
            isAdmin() ||
            (
              isCorporateCompanyActive(domainId) &&
              isCompanyAdmin(domainId) &&
              incoming().planId == get(/databases/$(database)/documents/corporate_companies/$(domainId)).data.planId
            )
          ) &&
          incoming().id == licenseId &&
          incoming().companyDomain == domainId &&
          incoming().email.lower().split('@')[1] == domainId &&
          incoming().invitedByUid == request.auth.uid &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time;

        allow update: if isValidDomainId(domainId) && isValidId(licenseId) &&
          isValidCorporateUserLicense(incoming()) &&
          incoming().id == existing().id &&
          incoming().email == existing().email &&
          incoming().companyDomain == existing().companyDomain &&
          incoming().invitedByUid == existing().invitedByUid &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          (
            (
              isAdmin() &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'displayName', 'planId', 'licenseKey', 'status', 'companyRole', 'incidentAccess', 'assignedUid', 'updatedAt'
              ])
            ) ||
            (
              isCorporateCompanyActive(domainId) &&
              isCompanyAdmin(domainId) &&
              incoming().planId in [existing().planId, get(/databases/$(database)/documents/corporate_companies/$(domainId)).data.planId] &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'displayName', 'planId', 'licenseKey', 'status', 'companyRole', 'incidentAccess', 'assignedUid', 'updatedAt'
              ])
            ) ||
            (
              isEmailVerified() &&
              isCorporateCompanyActive(domainId) &&
              licenseId == myEmailLicenseId() &&
              existing().email.lower() == request.auth.token.email.lower() &&
              incoming().displayName == existing().displayName &&
              incoming().planId == existing().planId &&
              incoming().licenseKey == existing().licenseKey &&
              incoming().status == existing().status &&
              incoming().companyRole == existing().companyRole &&
              incoming().get('incidentAccess', 'read') == existing().get('incidentAccess', 'read') &&
              incoming().assignedUid == request.auth.uid &&
              incoming().diff(existing()).affectedKeys().hasOnly(['assignedUid', 'updatedAt'])
            )
          );

        allow delete: if isValidDomainId(domainId) && isValidId(licenseId) && (
          isAdmin() ||
          (isCorporateCompanyActive(domainId) && isCompanyAdmin(domainId))
        );
      }

      // /corporate_companies/{domainId}/incidents/{incidentId}
      match /incidents/{incidentId} {
        allow get: if isValidDomainId(domainId) && isValidIncidentId(incidentId) && canReadCompanyIncidents(domainId);
        allow list: if isValidDomainId(domainId) && canReadCompanyIncidents(domainId);

        allow create: if isValidDomainId(domainId) && isValidIncidentId(incidentId) &&
          isSignedIn() &&
          canEditCompanyIncidents(domainId) &&
          isValidCorporatePackageIncident(incoming()) &&
          !exists(/databases/$(database)/documents/corporate_companies/$(domainId)/deleted_incidents/$(incidentId)) &&
          incoming().id == incidentId &&
          incoming().companyDomain == domainId &&
          incoming().createdByUid == request.auth.uid &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time;

        allow update: if isValidDomainId(domainId) && isValidIncidentId(incidentId) &&
          isSignedIn() &&
          canEditCompanyIncidents(domainId) &&
          isValidCorporatePackageIncident(incoming()) &&
          incoming().id == incidentId &&
          incoming().companyDomain == domainId &&
          incoming().updatedAt == request.time &&
          preservesIncidentMetadata(existing(), incoming());

        allow delete: if isValidDomainId(domainId) && isValidIncidentId(incidentId) && canEditCompanyIncidents(domainId);
      }

      // Tombstones prevent legacy browser caches from recreating deleted incidents.
      match /deleted_incidents/{incidentId} {
        allow get: if isValidDomainId(domainId) && isValidIncidentId(incidentId) && canReadCompanyIncidents(domainId);
        allow list: if isValidDomainId(domainId) && canReadCompanyIncidents(domainId);
        allow create: if isValidDomainId(domainId) && isValidIncidentId(incidentId) &&
          isSignedIn() &&
          canEditCompanyIncidents(domainId) &&
          incoming().keys().hasOnly(['id', 'companyDomain', 'deletedByUid', 'deletedAt']) &&
          incoming().id == incidentId &&
          incoming().companyDomain == domainId &&
          incoming().deletedByUid == request.auth.uid &&
          incoming().deletedAt == request.time;
        allow update: if isValidDomainId(domainId) && isValidIncidentId(incidentId) &&
          isSignedIn() &&
          canEditCompanyIncidents(domainId) &&
          incoming().keys().hasOnly(['id', 'companyDomain', 'deletedByUid', 'deletedAt']) &&
          incoming().id == existing().id &&
          incoming().companyDomain == existing().companyDomain &&
          incoming().id == incidentId &&
          incoming().companyDomain == domainId &&
          incoming().deletedByUid == request.auth.uid &&
          incoming().deletedAt == request.time;
        allow delete: if false;
      }

      // /corporate_companies/{domainId}/incident_audit_logs/{logId}
      match /incident_audit_logs/{logId} {
        allow get: if isValidDomainId(domainId) && isValidId(logId) && (
          isAdmin() ||
          (isCorporateCompanyActive(domainId) && isCompanyAdmin(domainId))
        );
        allow list: if isValidDomainId(domainId) && (
          isAdmin() ||
          (isCorporateCompanyActive(domainId) && isCompanyAdmin(domainId))
        );

        allow create: if isValidDomainId(domainId) && isValidId(logId) &&
          isSignedIn() &&
          canEditCompanyIncidents(domainId) &&
          isValidIncidentAuditLog(incoming()) &&
          incoming().id == logId &&
          incoming().companyDomain == domainId &&
          incoming().actorUid == request.auth.uid &&
          incoming().actorEmail.lower() == request.auth.token.email.lower() &&
          incoming().createdAt == request.time;

        allow update, delete: if false;
      }
    }

    // /plans/{planId}
    match /plans/{planId} {
      allow get: if isValidId(planId) && isSignedIn();
      allow list: if isSignedIn();

      allow create: if isValidId(planId) &&
        isAdmin() &&
        isValidPlanConfig(incoming()) &&
        incoming().id == planId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidId(planId) &&
        isAdmin() &&
        isValidPlanConfig(incoming()) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'description', 'priceMonthly', 'billingModel', 'pricePerLicense',
          'maxQueriesPerMonth', 'features', 'active', 'updatedAt'
        ]);

      allow delete: if isValidId(planId) && isAdmin();
    }

    // /access_logs/{logId}
    match /access_logs/{logId} {
      allow get: if isValidId(logId) && (
        isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid)
      );
      allow list: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);

      allow create: if isValidId(logId) &&
        isSignedIn() &&
        isValidAccessLog(incoming()) &&
        incoming().id == logId &&
        incoming().uid == request.auth.uid &&
        incoming().userEmail.lower() == request.auth.token.email.lower() &&
        incoming().userDomain == userEmailDomain() &&
        incoming().createdAt == request.time;

      allow update, delete: if isValidId(logId) && isAdmin();
    }

    // /admins/{userId}
    match /admins/{userId} {
      allow get: if isValidId(userId) && (isAdmin() || isOwner(userId));
      allow list: if isAdmin();
      allow create: if isValidId(userId) &&
        isAdmin() &&
        isValidAdminRegistry(incoming()) &&
        incoming().uid == userId &&
        incoming().createdAt == request.time;
      allow update, delete: if isValidId(userId) && isAdmin();
    }
  }
}
