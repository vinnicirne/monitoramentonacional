      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 120
        },
        "displayName": {
          "type": "string",
          "maxLength": 120
        },
        "companyDomain": {
          "type": "string",
          "maxLength": 120,
          "pattern": "^[a-z0-9.\\-]+$"
        },
        "planId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "licenseKey": {
          "type": "string",
          "maxLength": 64
        },
        "status": {
          "type": "string",
