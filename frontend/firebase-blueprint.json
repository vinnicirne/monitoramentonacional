{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated platform user profile with role, approval status, plan, domain and referral metadata",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 160
        },
        "domain": {
          "type": "string",
          "maxLength": 120,
          "pattern": "^[a-z0-9.\\-]+$"
        },
        "displayName": {
          "type": "string",
          "maxLength": 120
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500
        },
        "role": {
          "type": "string",
          "enum": ["user", "admin"]
        },
        "status": {
          "type": "string",
          "enum": ["approved", "pending", "blocked"]
        },
        "planId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "referralCode": {
          "type": "string",
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "referredByCode": {
          "type": "string",
          "maxLength": 32
        },
        "referredByUid": {
          "type": "string",
          "maxLength": 128
        },
        "referredByDomain": {
          "type": "string",
          "maxLength": 120
        },
        "autoApprovedBy": {
          "type": "string",
          "enum": ["admin_bootstrap", "free_domain", "meli_referral", "manual_admin", "pending_approval", "corporate_license"]
        },
        "licenseKey": {
          "type": "string",
          "maxLength": 64
        },
        "companyDomain": {
          "type": "string",
          "maxLength": 120
        },
        "licenseStatus": {
          "type": "string",
          "enum": ["active", "none", "suspended"]
        },
        "companyRole": {
          "type": "string",
          "enum": ["member", "company_admin"]
        },
        "accessCount": {
          "type": "number"
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "lastLoginAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "email",
        "domain",
        "displayName",
        "photoURL",
        "role",
        "status",
        "planId",
        "referralCode",
        "referredByCode",
        "referredByUid",
        "referredByDomain",
        "autoApprovedBy",
        "accessCount",
        "notes",
        "createdAt",
        "updatedAt",
        "lastLoginAt"
      ]
    },
    "ReferralCode": {
      "title": "ReferralCode",
      "description": "Shareable affiliate/referral code owned by a user (no financial commission)",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerName": {
          "type": "string",
          "maxLength": 120
        },
        "ownerDomain": {
          "type": "string",
          "maxLength": 120,
          "pattern": "^[a-z0-9.\\-]+$"
        },
        "active": {
          "type": "boolean"
        },
        "totalReferrals": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "code",
        "ownerUid",
        "ownerName",
        "ownerDomain",
        "active",
        "totalReferrals",
        "createdAt",
        "updatedAt"
      ]
    },
    "ReferralRecord": {
      "title": "ReferralRecord",
      "description": "Individual referral relationship tracking direct MELI auto-approval vs pending external review",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "code": {
          "type": "string",
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "referrerUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "referrerName": {
          "type": "string",
          "maxLength": 120
        },
        "referrerDomain": {
          "type": "string",
          "maxLength": 120
        },
        "referredUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "referredName": {
          "type": "string",
          "maxLength": 120
        },
        "referredEmail": {
          "type": "string",
          "format": "email",
          "maxLength": 160
        },
        "referredDomain": {
          "type": "string",
          "maxLength": 120
        },
        "status": {
          "type": "string",
          "enum": ["approved", "pending", "revoked"]
        },
        "autoApproved": {
          "type": "boolean"
        },
        "commissionEnabled": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "code",
        "referrerUid",
        "referrerName",
        "referrerDomain",
        "referredUid",
        "referredName",
        "referredEmail",
        "referredDomain",
        "status",
        "autoApproved",
        "commissionEnabled",
        "createdAt",
        "updatedAt"
      ]
    },
    "FreeDomain": {
      "title": "FreeDomain",
      "description": "Email domain allowed free direct access and/or automatic referral approval",
      "type": "object",
      "properties": {
        "domain": {
          "type": "string",
          "maxLength": 120,
          "pattern": "^[a-z0-9.\\-]+$"
        },
        "label": {
          "type": "string",
          "maxLength": 100
        },
        "active": {
          "type": "boolean"
        },
        "autoApproveReferrals": {
          "type": "boolean"
        },
        "defaultPlanId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "domain",
        "label",
        "active",
        "autoApproveReferrals",
        "defaultPlanId",
        "createdAt",
        "updatedAt"
      ]
    },
    "PlanConfig": {
      "title": "PlanConfig",
      "description": "Subscription/access plan configuration managed in the Admin console",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "maxLength": 300
        },
        "priceMonthly": {
          "type": "number"
        },
        "billingModel": {
          "type": "string",
          "enum": ["fixed", "per_user"]
        },
        "pricePerLicense": {
          "type": "number"
        },
        "maxQueriesPerMonth": {
          "type": "number"
        },
        "features": {
          "type": "array"
        },
        "active": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "priceMonthly",
        "maxQueriesPerMonth",
        "features",
        "active",
        "createdAt",
        "updatedAt"
      ]
    },
    "AccessLog": {
      "title": "AccessLog",
      "description": "Audit log of DP/CISP/territory/location views accessed by authenticated users",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userName": {
          "type": "string",
          "maxLength": 120
        },
        "userEmail": {
          "type": "string",
          "format": "email",
          "maxLength": 160
        },
        "userDomain": {
          "type": "string",
          "maxLength": 120
        },
        "targetType": {
          "type": "string",
          "maxLength": 40
        },
        "targetName": {
          "type": "string",
          "maxLength": 160
        },
        "uf": {
          "type": "string",
          "maxLength": 16
        },
        "municipio": {
          "type": "string",
          "maxLength": 100
        },
        "cisp": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "uid",
        "userName",
        "userEmail",
        "userDomain",
        "targetType",
        "targetName",
        "uf",
        "municipio",
        "cisp",
        "createdAt"
      ]
    },
    "CorporateCompany": {
