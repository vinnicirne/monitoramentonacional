    "CorporatePackageIncident": {
      "title": "CorporatePackageIncident",
      "description": "Lost/fraudulent package incident linked to a police station (delegacia) and custody status",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "companyDomain": {
          "type": "string",
          "maxLength": 120,
          "pattern": "^[a-z0-9.\\-]+$"
        },
        "trackingCode": {
          "type": "string",
          "maxLength": 80
        },
        "incidentType": {
          "type": "string",
          "enum": ["extravio", "fraude", "roubo_carga", "apreensao", "outros"]
        },
        "boNumber": {
          "type": "string",
          "maxLength": 64
        },
        "delegaciaId": {
          "type": "string",
          "maxLength": 64
        },
        "delegaciaName": {
          "type": "string",
          "maxLength": 160
        },
        "delegaciaUf": {
          "type": "string",
          "maxLength": 8
        },
        "delegaciaMunicipio": {
          "type": "string",
          "maxLength": 100
        },
        "packageAtStation": {
          "type": "boolean"
        },
        "custodyStatus": {
          "type": "string",
          "enum": [
            "em_ocorrencia_delegacia",
            "aguardando_pericia",
            "liberado_retirada",
            "devolvido_empresa",
            "extraviado_nao_localizado"
          ]
        },
        "estimatedValue": {
          "type": "number"
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        },
        "createdByUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdByName": {
          "type": "string",
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "companyDomain",
        "trackingCode",
        "incidentType",
        "boNumber",
        "delegaciaId",
        "delegaciaName",
        "delegaciaUf",
        "delegaciaMunicipio",
        "packageAtStation",
        "custodyStatus",
        "estimatedValue",
        "notes",
        "createdByUid",
        "createdByName",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminRegistry": {
      "title": "AdminRegistry",
      "description": "Admin role assignment registry",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 160
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profiles containing PII; strictly readable/writable by owner or admin"
    },
    "/referral_codes/{code}": {
      "schema": { "$ref": "#/entities/ReferralCode" },
      "description": "Public/auth-lookup affiliate referral codes without PII"
    },
    "/referrals/{referralId}": {
      "schema": { "$ref": "#/entities/ReferralRecord" },
      "description": "Individual referral links between referrer and referred user"
    },
    "/free_domains/{domainId}": {
      "schema": { "$ref": "#/entities/FreeDomain" },
      "description": "Free-access corporate domains (e.g. mercadolivre.com) managed by admins"
    },
    "/corporate_companies/{domainId}": {
      "schema": { "$ref": "#/entities/CorporateCompany" },
      "description": "Corporate companies (@empresa.com) with per-user license pricing and seat controls"
    },
    "/corporate_companies/{domainId}/licenses/{licenseId}": {
      "schema": { "$ref": "#/entities/CorporateUserLicense" },
      "description": "Per-user corporate licenses managed by system admins and company admins"
    },
    "/corporate_companies/{domainId}/incidents/{incidentId}": {
      "schema": { "$ref": "#/entities/CorporatePackageIncident" },
      "description": "Lost/fraudulent package incidents linked to police stations and custody tracking"
    },
    "/plans/{planId}": {
      "schema": { "$ref": "#/entities/PlanConfig" },
      "description": "Subscription plans configured by admins"
    },
    "/access_logs/{logId}": {
      "schema": { "$ref": "#/entities/AccessLog" },
      "description": "Location & DP access audit history"
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminRegistry" },
      "description": "Trusted administrator lookup table"
    }
  }
}
